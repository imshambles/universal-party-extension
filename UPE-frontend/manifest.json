{
  "manifest_version": 3,
  "name": "Party Extension",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://universal-party-extension.onrender.com/",
    "https://*.peerjs.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.hulu.com/*",
        "*://*.disneyplus.com/*",
        "*://*.primevideo.com/*"
      ],
      "js": [
        "libs/socket.io.min.js",
        "libs/peerjs.min.js",
        "contentScript.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "video-chat.html",
        "sidebar.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://universal-party-extension.onrender.com wss://universal-party-extension.onrender.com https://*.peerjs.com wss://*.peerjs.com"
  }
}