{
  "manifest_version": 3,
  "name": "Universal Party",
  "version": "1.0",
  "description": "Watch anything together, in sync — synced play/pause/seek, group video chat, and text chat on Netflix, Prime Video, Disney+, Hulu, Hotstar, and YouTube.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://universal-party-extension.onrender.com/",
    "https://*.peerjs.com/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal Party"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.hulu.com/*",
        "*://*.disneyplus.com/*",
        "*://*.primevideo.com/*",
        "*://*.hotstar.com/*",
        "*://*.youtube.com/*",
        "*://localhost/*",
        "file://*"
      ],
      "js": [
        "libs/socket.io.min.js",
        "libs/peerjs.min.js",
        "contentScript.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "video-chat.html",
        "sidebar.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://universal-party-extension.onrender.com wss://universal-party-extension.onrender.com https://*.peerjs.com wss://*.peerjs.com"
  }
}